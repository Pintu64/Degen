{
  "$schema": "https://railway.com/graph.schema.json",
  "variables": {
    "APP_ENV": "production",
    "DATABASE_URL": "${{Postgres.DATABASE_URL}}",
    "DEXSCREENER_BASE_URL": "https://api.dexscreener.com",
    "AI_ENABLED": "true",
    "AI_BASE_URL": "https://agentrouter.org/v1",
    "AI_MODEL": "glm-5.3",
    "TRACKING_INTERVAL_SECONDS": "10",
    "SCAN_INTERVAL_SECONDS": "8",
    "MIN_LIQUIDITY_USD": "5000",
    "MIN_VOLUME_24H_USD": "3000",
    "MIN_TXNS_24H": "20",
    "MIN_SCORE": "78",
    "WARN_CALL_SCORE": "85",
    "DEFAULT_MILESTONES": "1.25,1.5,2,3,5,10,20,50",
    "ENABLED_CHAINS": "solana,ethereum,bsc,base",
    "MAX_DEGEN_PICKS": "1",
    "MAX_DEGEN_ALERTS_PER_CYCLE": "1",
    "MAX_DEGEN_MARKET_CAP_USD": "400000",
    "MAX_DEGEN_LIQUIDITY_USD": "150000",
    "MAX_DEGEN_24H_CHANGE_PERCENT": "250",
    "MIN_DEGEN_PAIR_AGE_SECONDS": "60",
    "MAX_DEGEN_PAIR_AGE_SECONDS": "86400",
    "OFFICIAL_CALL_GAP_SECONDS": "600",
    "BIRDEYE_BASE_URL": "https://public-api.birdeye.so",
    "SNAPSHOT_RETENTION_DAYS": "30",
    "LOG_LEVEL": "INFO"
  },
  "services": [
    {
      "name": "bot",
      "variables": {"SERVICE_ROLE": "bot"},
      "deploy": {"startCommand": "alembic upgrade head && python -m app.main"}
    },
    {
      "name": "scanner",
      "variables": {"SERVICE_ROLE": "scanner"},
      "deploy": {"startCommand": "alembic upgrade head && python -m app.main"}
    },
    {
      "name": "tracker",
      "variables": {"SERVICE_ROLE": "tracker"},
      "deploy": {"startCommand": "alembic upgrade head && python -m app.main"}
    },
    {
      "name": "telegram",
      "variables": {"SERVICE_ROLE": "telegram"},
      "deploy": {"startCommand": "alembic upgrade head && python -m app.main"}
    }
  ]
}
